{%- style -%}
@font-face {
    font-family: 'DIN Next LT Pro';
    src: url({{ "DINNextLTPro-Bold.eot" | asset_url }});
    src: url({{ "DINNextLTPro-Bold.eot?#iefix" | asset_url }}) format('embedded-opentype'),
        url({{ "DINNextLTPro-Bold.woff2" | asset_url }}) format('woff2'),
        url({{ "DINNextLTPro-Bold.woff" | asset_url }}) format('woff'),
        url({{ "DINNextLTPro-Bold.ttf" | asset_url }}) format('truetype'),
        url({{ "DINNextLTPro-Bold.svg#DINNextLTPro-Bold" | asset_url }}) format('svg');
    font-weight: bold;
    font-style: normal;
    font-display: swap;
}

