
{{ 'video-banner-slider.css' | asset_url | stylesheet_tag }}



{% javascript %}

(function(win) {
    'use strict';

    var listeners = [],
    doc = win.document,
    MutationObserver = win.MutationObserver || win.WebKitMutationObserver,
    observer;

    function ready(selector, fn) {
        // Store the selector and callback to be monitored
        listeners.push({
            selector: selector,
            fn: fn
        });
        if (!observer) {
            // Watch for changes in the document
            observer = new MutationObserver(check);
            observer.observe(doc.documentElement, {
                childList: true,
                subtree: true
            });
        }
        // Check if the element is currently in the DOM
        check();
    }

    function check() {
        // Check the DOM for elements matching a stored selector
        for (var i = 0, len = listeners.length, listener, elements; i < len; i++) {
            listener = listeners[i];
            // Query for elements matching the specified selector
            elements = doc.querySelectorAll(listener.selector);
            for (var j = 0, jLen = elements.length, element; j < jLen; j++) {
                element = elements[j];
                // Make sure the callback isn't invoked with the
                // same element more than once
                if (!element.ready) {
                    element.ready = true;
                    // Invoke the callback with the element
                    listener.fn.call(element, element);
                }
            }
        }
    }

    // Expose `ready`
    win.ready = ready;

})(window);

ready('.swiper-video',function(){
  setTimeout(function(){
    const swiperVideo = new Swiper('.swiper-video', {
    slidesPerView: 1.345,
    spaceBetween: 20,
    centeredSlides: true,
    loop: true,
    grabCursor: true,
    freeMode: false,
    navigation: {
            nextEl: ".swiper-button-next",
            prevEl: ".swiper-button-prev",
          },
    breakpoints: {
        1024: {
          slidesPerView: 1.6129,
          spaceBetween: 10,
        }
      }
    });
  }, 100);
});

{% endjavascript %}
{% style %}
.collection-banner div:empty {
 display:block;
}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.71 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.71 | round: 0 }}px;
}

@media screen and (min-width: 1024px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}
{% endstyle %}

<section class="video-slider color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %} animation-element">
    <div class="video-slider-inner ">
       <h3 class="h2 center f-italic {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">{{ section.settings.title }}</h3>
       <div class="video-slider-slider swiper swiper-video">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
                <div class="item swiper-slide">
                    <a data-fancybox href="{{ block.settings.videoLink }}" onclick="videoAutoPlay();" class="video-wrapper" title="video of {{ block.settings.text }}">
                        <div class="video-figure">
                            <div class="video-img">
                                <img class="" src="{{ block.settings.video_img | img_url:"" }}" alt="{{ block.settings.categoryName }}" height="" width="">
                            </div>
                            <div class="btn">
                              <span class="video-arrow">{% render 'icon-btn-play' %}</span>
                            </div>
                        </div>
                    </a>
                    <div class="bottom-content">
                    <p class="center {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">{{ block.settings.text }}</p>
                    </div>
                </div>
            {%- endfor -%}
          </div>
          <div class="swiper-button-prev">{% render 'icon-left-arrow' %}</div>
          <div class="swiper-button-next">{% render 'icon-btn-arrow' %}</div>
      </div>
      </div>
      <div class="bottom-content">
      <div class="btn-below center {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <a href="{{ section.settings.btn_url}}" class="button" target="_blank">
      <span class="btn-name">{{ section.settings.btn_name }}</span>
      <span class="btn-arrow">{% render 'icon-btn-arrow' %}</span>
      </a>
      </div>
        </div>
      </section>

      {% schema %}
    {
      "name": "Video Banner Slider",
      "tag": "section",
      "class": "section-collection-banner",
      "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.all.colors.label",
            "default": "scheme-1"
        },
        {
            "type": "html",
            "id": "title",
            "label": "Title",
            "default": "Watch Our Latest Videos"
        },
        {
            "type": "text",
            "id": "btn_name",
            "label": "Button Name",
            "default": "More Videos"
        },
        {
          "type": "url",
          "id": "btn_url",
          "label": "Button Link"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 2,
            "unit": "px",
            "label": "t:sections.all.padding.padding_top",
            "default": 0
          },
          {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 2,
            "unit": "px",
            "label": "t:sections.all.padding.padding_bottom",
            "default": 50
          }
      ],
      "blocks": [
        {
            "type": "column",
            "name": "item",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "video_img",
                    "label": "Video Image",
                    "info" : "Recommend Size '1778 x 1000px' and Format 'jPG' "
                },
                {
                  "type": "text",
                  "id": "text",
                  "label": "Text",
                  "default": "Text"
                },
                {
                    "type": "text",
                    "id": "videoLink",
                    "label": "Video Link",
                    "placeholder": "https://"
                }
                
            ]
        }
    ],
    "presets": [
        {
          "name": "Video Banner Slider",
          "blocks": [
            {
              "type": "column"
            },
            {
              "type": "column"
            },
            {
              "type": "column"
            }
          ]
        }
      ]
    }
{% endschema %}
