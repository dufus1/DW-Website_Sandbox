{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}

{%- style -%} 
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.67 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px;
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  } 
{%- endstyle -%}
<div class="collection-top-banner">
  <div class="page-width">
      <div class="collection-top-banner-inner">
        <h1 class="main-page-title  page-title title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
          {{ page.title | escape }}
        </h1>
      </div>
  </div>
</div>

{% schema %}
  {
    "name": "faq template",
    "class": "section-faq",
    "settings": []
  }
{% endschema %}