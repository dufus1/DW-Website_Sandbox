{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.24 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px;
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{% comment %}
	Google Map
{% endcomment %}

{% if section.settings.display_google_map %}
	<div class="map">
		{% if section.settings.google_map_code != blank %}
			{{ section.settings.google_map_code }}
		{% endif %}
	</div>
{% endif %}

